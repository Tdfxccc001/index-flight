{
  "name": "index-flight",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/finalize-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:pages": "node scripts/pages-browser-test.mjs",
    "test:pages-performance": "node scripts/pages-performance.mjs --hardware"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.7.2",
    "@types/three": "0.180.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "packageManager": "pnpm@11.25.0"
}
